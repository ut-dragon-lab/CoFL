{
  "name": "@cofl/studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-decoders.mjs",
    "prebuild": "node scripts/copy-decoders.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
